{
  "name": "cms",
  "version": "1.0.0",
  "description": "Payload 3 CMS backend with SQLite",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/check-migrations.ts && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "check": "next typegen && tsc --noEmit && cross-env NODE_OPTIONS=--no-deprecation eslint . && prettier --check . && cross-env NODE_OPTIONS=--no-deprecation tsx scripts/check-migrations.ts",
    "db:backup": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/db.ts backup",
    "db:check": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/check-db.ts",
    "db:clear": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/db.ts clear",
    "db:restore": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/db.ts restore",
    "format": "prettier --write .",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.4.1",
    "payload": "3.93.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.1",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1",
    "pnpm": "^9 || ^10 || ^11"
  }
}

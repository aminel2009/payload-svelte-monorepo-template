# Server port (serves both SvelteKit Web and Payload CMS on one port)
PORT=3000

# Payload CMS (SQLite)
DATABASE_URL=file:./data/payload.db
PAYLOAD_SECRET=YOUR_SECRET_HERE

# SvelteKit Web
# Relative path works across dev, local start, and single-container Docker.
# Set a full URL if deploying frontend and CMS separately.
PUBLIC_GRAPHQL_ENDPOINT=/_/api/graphql

# Optional override used only by graphql-codegen (defaults to http://127.0.0.1:${PORT}/_/api/graphql)
# GRAPHQL_SCHEMA_URL=http://127.0.0.1:3000/_/api/graphql
